{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\py-compile-check.ps1\"",
            "timeout": 30,
            "statusMessage": "py_compile"
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\stale-exe-check.ps1\"",
            "timeout": 15,
            "statusMessage": "checking exe freshness"
          }
        ]
      }
    ]
  }
}
